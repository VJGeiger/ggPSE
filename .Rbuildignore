^data-raw$        # data generation scripts
^README\.md$      # GitHub readme, not needed in package
^TODO\.md$        # your roadmap file
^\.github$        # GitHub Actions etc
^vignettes/.*\.html$  # pre-built vignette HTML if any
^docs$            # pkgdown site
^.*\.Rproj$       # RStudio project file
^\.Rproj\.user$   # RStudio user settings
